GEMINI_API_KEY=
# Leave empty to use MockGeminiService (filler suggestions for local testing).
GEMINI_MODEL=gemini-3.6-flash
ADB_DEVICE=127.0.0.1:5555
# EasyOCR requires CUDA. Install a CUDA-enabled PyTorch build for your driver;
# stock `pip install torch` is often CPU-only and will fail at OCR init.
